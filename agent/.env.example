# FlowAI phone agent. Copy to .env and fill in the token.

# FlowAI's API, and the token from Dashboard → Phones → The automation service.
FLOWAI_URL=http://localhost:8000
FLOWAI_AGENT_TOKEN=

# Optional: where adb and scrcpy are, if they aren't found on their own.
# FLOWAI_ADB=C:\platform-tools\adb.exe
# FLOWAI_SCRCPY=C:\Tools\scrcpy

# Optional: a simulated phone next to the real ones, to try the loop without hardware.
# FLOWAI_SIMULATED_PHONES=sim-1

# Hackathon phone-control API (console: https://<host>/team). The console's API base
# already ends in /v1; do not add a trailing slash.
# HACK_API_BASE=https://172.26.0.32/hack/v1
# HACK_TEAM_KEY=
